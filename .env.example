# Cloudflare Pages 环境变量配置示例
# 复制此文件为 .env 并填入你的后端 API 地址

# 后端 API 基础 URL（必填）
# 例如：https://mail.yourdomain.com
VITE_APP_API_URL=

# 可选：是否在 Cloudflare Pages Functions 中启用 API 代理
# 如果启用，前端可以直接调用 /api/*，由 Functions 转发到后端
# VITE_USE_FUNCTIONS_PROXY=true

# ============= 第三方邮件服务配置（可选）============
# 如果不需要完整的 PMail 后端，可以使用第三方邮件服务直接发信

# 邮件服务商：resend / sendgrid / mailgun
EMAIL_PROVIDER=resend

# 默认发件人邮箱
FROM_EMAIL=noreply@yourdomain.com

# Resend API Key（https://resend.com）
RESEND_API_KEY=re_xxxxx

# SendGrid API Key（可选，https://sendgrid.com）
SENDGRID_API_KEY=SG.xxxxx

# Mailgun 配置（可选，https://mailgun.com）
MAILGUN_API_KEY=key-xxxxx
MAILGUN_DOMAIN=mg.yourdomain.com
